{
    "version": "8.0.31",
    "description": "Microsoft .NET 8.0 Runtime, installed from the ZIP archive without admin rights",
    "homepage": "https://dotnet.microsoft.com/download/dotnet/8.0",
    "license": "MIT",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.31/dotnet-runtime-8.0.31-win-x64.zip",
            "hash": "sha512:9c55c58694676ee64b0eed2cd6d8cbf58b9aa8288420acc66841e15ca0099c75d4af0182d23a641c2342e5a151a325df4a12fa0bde2e47c0fb7e9a33e7b09896"
        },
        "32bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.31/dotnet-runtime-8.0.31-win-x86.zip",
            "hash": "sha512:c8d8597dcbfa09fa267dde0e04d628360ade272f6ec1dc46f8896a58712bb6ec19e8b9ed1a9061786b99e3b4723cfb4c438e06268b1120c3a568bcae54551c9c"
        },
        "arm64": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.31/dotnet-runtime-8.0.31-win-arm64.zip",
            "hash": "sha512:4c01f325accb1abdea354b5a7c1422299c6d48b267dd86f4173962259542b25b8f2d19787be4b3753d7aaae9a99386fff9eb90581ffb6564e47bef932aaeeace"
        }
    },
    "post_install": [
        "# Link this runtime into the root shared by all dotnetN-runtime packages (side-by-side)",
        "$root = Join-Path (basedir $global) 'shared\\dotnet'",
        "foreach ($d in Get-ChildItem \"$original_dir\\host\\fxr\\*\", \"$original_dir\\shared\\*\\*\" -Directory) {",
        "    $link = Join-Path $root $d.FullName.Substring($original_dir.Length + 1)",
        "    New-Item -ItemType Directory -Force (Split-Path $link) | Out-Null",
        "    if (Get-Item $link -Force -ErrorAction SilentlyContinue) { [IO.Directory]::Delete($link) }",
        "    New-Item -ItemType Junction -Path $link -Target $d.FullName | Out-Null",
        "}",
        "$exe = \"$root\\dotnet.exe\"",
        "if (!(Test-Path $exe) -or (Get-Item $exe).VersionInfo.FileMajorPart -lt (Get-Item \"$original_dir\\dotnet.exe\").VersionInfo.FileMajorPart) {",
        "    Copy-Item \"$original_dir\\dotnet.exe\" $exe -Force",
        "}",
        "New-Item -ItemType Junction -Path \"$original_dir\\dotnet-root\" -Target $root | Out-Null"
    ],
    "env_add_path": "dotnet-root",
    "env_set": {
        "DOTNET_ROOT": "$(basedir $global)\\shared\\dotnet"
    },
    "pre_uninstall": [
        "# Unlink only this package's runtime; other dotnetN-runtime packages are left untouched",
        "$root = Join-Path (basedir $global) 'shared\\dotnet'",
        "if (Get-Item \"$dir\\dotnet-root\" -Force -ErrorAction SilentlyContinue) { [IO.Directory]::Delete(\"$dir\\dotnet-root\") }",
        "if (Test-Path $root) {",
        "    $pattern = \"$root\\host\\fxr\\*\", \"$root\\shared\\*\\*\"",
        "    Get-ChildItem $pattern -Directory | Where-Object { \"$($_.Target)\".StartsWith(\"$dir\\\", 'OrdinalIgnoreCase') } | ForEach-Object { [IO.Directory]::Delete($_.FullName) }",
        "    if (!(Get-ChildItem $pattern -Directory)) { Remove-Item $root -Recurse -Force }",
        "}"
    ],
    "post_uninstall": [
        "# env_set removal wiped DOTNET_ROOT; restore it while another runtime remains",
        "$root = Join-Path (basedir $global) 'shared\\dotnet'",
        "if (Test-Path $root) {",
        "    Set-EnvVar -Name 'DOTNET_ROOT' -Value $root -Global:$global",
        "    $env:DOTNET_ROOT = $root",
        "}"
    ],
    "checkver": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/releases-index.json",
        "jsonpath": "$.releases-index[?(@.channel-version == '8.0')].latest-runtime",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/$version/dotnet-runtime-$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/$version/dotnet-runtime-$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/$version/dotnet-runtime-$version-win-arm64.zip"
            }
        },
        "hash": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/$majorVersion.$minorVersion/releases.json",
            "regex": "(?s)$basename.*?$sha512"
        }
    }
}
