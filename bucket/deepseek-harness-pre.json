{
    "version": "0.2.2-rc.5",
    "description": "Open-source agent harness developed by DeepSeek AI (desktop preview).",
    "homepage": "https://deepseek.com/harness",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.2-rc.5-win-x64.exe#/dl.7z",
            "hash": "sha512:c16c92469ec793981c1f7db88c1c4073b295d269e21f3403a1fc907b13893080165c19201d3b110abdc8addc17d573bc38884366c2d89af7b898bc6c92291822",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
            ]
        }
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii",
        "# The 'current' junction makes the app load duplicate modules and breaks settings saves; start from the real version dir",
        "startmenu_shortcut \"$original_dir\\DeepSeek Harness.exe\" 'DeepSeek Harness (Preview)' $null $null $global",
        "shim \"$original_dir\\resources\\runtime\\cli\\bin\\dsh.cmd\" $global 'dsh'"
    ],
    "post_uninstall": [
        "# Remove shortcut and shim",
        "rm_shim 'dsh' \"$(shimdir $global)\" $app",
        "Write-Host \"Removing shortcut $(friendly_path \"$(shortcut_folder $global)\\DeepSeek Harness (Preview).lnk\")\"",
        "Remove-Item \"$(shortcut_folder $global)\\DeepSeek Harness (Preview).lnk\" -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
        "regex": "version: ([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
            "regex": "(?s)sha512:.*?$base64"
        }
    }
}
