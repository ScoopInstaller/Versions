    "license": "MIT",
    "notes": [
        "This package provides Sophia Script for Windows 10 Enterprise LTSC 2019 only.",
        "Other editions: sophia-script, sophia-script-ps7, sophia-script-ltsc2024, sophia-script-ltsc2024-ps7, sophia-script-win10, sophia-script-win10-ps7, sophia-script-ltsc2021.",
        "The Sophia and SophiaScript commands start a launcher. It runs Sophia.ps1 in Windows PowerShell 5.1 (powershell.exe) from any shell (PowerShell 5.1, PowerShell 7 or CMD).",
        "Sophia.ps1 is the preset. Your function selections in it are not kept on update. Keep your own copy of the edited file and use it after each update."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/farag2/Sophia-Script-for-Windows/releases/download/8.1.0/Sophia.Script.for.Windows.10.LTSC.2019.v7.1.0.zip",
            "hash": "f4383c7f01a9f3940eb7932bb49189399f0af9f32611064019d5bfa5a905a02a",
            "extract_dir": "Sophia_Script_for_Windows_10_LTSC_2019_v7.1.0"
        }
    },
    "pre_install": [
        "$Build = [int](Get-ItemPropertyValue -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -Name CurrentBuild)",
        "$ProductName = Get-ItemPropertyValue -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -Name ProductName",
        "if (-not (($Build -eq 17763) -and ($ProductName -match 'LTSC 2019'))) {",
        "    $AppDir = Split-Path -Path $dir -Parent",
        "    Remove-Item -LiteralPath $dir -Recurse -Force",
        "    if (-not (Get-ChildItem -LiteralPath $AppDir -Force)) { Remove-Item -LiteralPath $AppDir -Force }",
        "    abort \"This package is for Windows 10 Enterprise LTSC 2019. Detected: $ProductName (build $Build). Run 'scoop search sophia-script' to pick the right edition.\"",
        "}",
        "Set-Content -LiteralPath \"$dir\\Sophia.cmd\" -Value '@echo off', 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%~dp0Sophia.ps1\" %*' -Encoding Ascii"
    ],
    "bin": [
        [
            "Sophia.cmd",
            "Sophia"
        ],
        [
            "Sophia.cmd",
            "SophiaScript"
        ]
    ],
    "checkver": {
        "url": "https://raw.githubusercontent.com/farag2/Sophia-Script-for-Windows/main/sophia_script_versions.json",
        "regex": "(?s)^(?=.*?\"Sophia_Script_Windows_11_PowerShell_5_1\"\\s*:\\s*\"(?<tag>[\\d.]+)\").*?\"Sophia_Script_Windows_10_LTSC2019\"\\s*:\\s*\"(?<version>[\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
