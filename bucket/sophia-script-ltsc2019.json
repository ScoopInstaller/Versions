                "url": "https://github.com/farag2/Sophia-Script-for-Windows/releases/download/$matchTag/Sophia.Script.for.Windows.10.LTSC.2019.v$version.zip",
                "extract_dir": "Sophia_Script_for_Windows_10_LTSC_2019_v$version"
            }
        }
    }
