{
    "version": "3.44.14-1",
    "description": "A free and open source geographic information system (GIS)",
    "homepage": "https://www.qgis.org/",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://download.qgis.org/downloads/QGIS-OSGeo4W-3.44.14-1.msi",
            "hash": "0a579f980dcec85be2ecb47c5f08234ca6ce7b625c3cb9543eded1f43d445b46"
        }
    },
    "extract_dir": "QGIS 3.44.14",
    "post_install": [
        "if (-not $global) {",
        "  (Get-Content \"$dir\\etc\\postinstall\\qgis-ltr.bat\" -Raw).Replace('\"%WINDIR%\\regedit\" /s', '\"%SystemRoot%\\System32\\reg.exe\" import') |",
        "    Set-Content \"$dir\\etc\\postinstall\\qgis-ltr.bat\" -Encoding Ascii",
        "  Get-ChildItem \"$dir\\apps\\qgis-ltr\" -Filter qgis.reg.tmpl -Recurse |",
        "    ForEach-Object { (Get-Content $_.FullName -Raw).Replace('HKEY_CLASSES_ROOT', 'HKEY_CURRENT_USER\\Software\\Classes') | Set-Content $_.FullName -Encoding Ascii }",
        "}",
        "& \"$dir\\etc\\postinstall.bat\" \"$(shortcut_folder $global)\\OSGeo4W\" \"%USERPROFILE%\\Desktop\" 0 1"
    ],
    "bin": [
        "OSGeo4W.bat",
        "bin\\o4w_env.bat"
    ],
    "pre_uninstall": "& \"$dir\\etc\\preremove.bat\"",
    "checkver": {
        "url": "https://github.com/qgis/QGIS-Website/raw/main/data/conf.json",
        "jsonpath": "$.ltr_msi",
        "regex": "/QGIS-OSGeo4W-([\\d.]+(-\\d+)?)\\.msi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.qgis.org/downloads/QGIS-OSGeo4W-$version.msi",
                "hash": {
                    "url": "https://download.qgis.org/downloads/QGIS-OSGeo4W-$version.sha256sum"
                }
            }
        },
        "extract_dir": "QGIS $majorVersion.$minorVersion.$patchVersion"
    }
}
