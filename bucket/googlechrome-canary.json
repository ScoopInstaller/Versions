        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/accotfj4xybxof2hsemi6os2u6na_159.0.8142.0/159.0.8142.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3da77fd959de5f7f6c06d780b83fa04967b1eb52867e6ef7ddfbcf10662913e4"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/hzai4jf3bnxvqdtmast57dm3zm_159.0.8142.1/159.0.8142.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "08fa168c38b59d7d086e1f15fcfe20fd39dd9104ce1041e677222393399bd9d4"
