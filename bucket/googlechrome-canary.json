        "arm64": {
            "url": "https://dl.google.com/release2/chrome/iq6hgauuxguudgfw4rvfe536se_159.0.8136.0/159.0.8136.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "d3449f55ec8d71a3824fe4007bcaa4f571d92a75be8352db10fdc279faa01f62"
