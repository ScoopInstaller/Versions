        "arm64": {
            "url": "https://dl.google.com/release2/chrome/onoc2mkxub5fsrgta5mraswwl4_158.0.8119.0/158.0.8119.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "0edae7ae007a8fbf3fc9c3e90857850cc24464218ae78616ac60c1293cb987af"
