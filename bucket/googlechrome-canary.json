            "hash": "57ba9ddf4c5fee4b4da18c50251510d30ca8ba93fb10e4ab2f1da8555f95b81f"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ada2pgvtac663gyxon7fb5u46mda_158.0.8113.0/158.0.8113.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ff488f0e2745fd212cdc3251db9188df6e921c0a8bc04b91b56dcf5d543b78f9"
