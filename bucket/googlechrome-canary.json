        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/e2rfwsjc3hng63cqt4hkzukfc4_157.0.8100.0/157.0.8100.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "bf4ac6b9b02828757e57ac24b29cdd00914b1a35ed1b8d12d675339ea3a9dcbf"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/owqrdzqapomzgm3vagxpvt46eu_157.0.8100.0/157.0.8100.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "cd8a15f2116aa0a2505073ecc67723af6123f91eecbe265a65282fbe4ad4c09a"
