        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ac5mejkkdpjlt7iopvaaiopas7ia_155.0.8059.0/155.0.8059.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "98bb5bde54176f55cd90628ba4359f0a3afebf21c5b0e28a03e5a83899007dc6"
