            "hash": "20191fe53d7b7e00f8dd341303e42e96f8bc6cd602c21197ea78152a480739ae"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/e4r7g6eqdxo5qmveqemf3buway_155.0.8055.0/155.0.8055.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "44255f79535adb2eb75088304877c630d213bb26fd5e50b46f33ab406b75eca4"
