            "hash": "77ea488310734c02edc12c2d48f4356031941f792b8f02bd5b848510bc37d72b"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/j55mfihgeq26uydlgea6frutyq_157.0.8096.0/157.0.8096.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3969d3de02ca7729337db1a10d3248de90b467d383189ba263d9009181bfbf6d"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/actmkxzri3iegtstwj3cuq7p5rha_157.0.8096.0/157.0.8096.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "cbe4e60c567846e887b795675892ddb49d3537c1e7f40fa51adfb95bbcc93106"
