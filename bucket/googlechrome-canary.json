        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adiifnfyx2rwkvctkwpb56bhvrjq_154.0.8031.0/154.0.8031.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "74d399cd29fddedc2bc1d655a1805ff3becd68a3340eec121d5476482197bc34"
