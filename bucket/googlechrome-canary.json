            "hash": "9f132aad6ceb72922ed657d26b057dec1c1375e618dbdb94f0d3110d75ac57ba"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/eiqo3t7z62akvmnzpc4nx75usy_158.0.8127.0/158.0.8127.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "a2ce869f3dc00c11fb799dfccbd1da380b1910e9512bc20c7b5e2000403e8f3a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/nkhw6umxpxrszjy45hl7ivllca_158.0.8127.0/158.0.8127.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "8eee618468c57faa85aab76cf6f828349ec9ef7c25ff699116feb79277251a50"
