            "hash": "69ae98a2a1585a04c70ee26cba386d4f44c291e7d8c989a453d1b3cca1308014"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adpgrfuoc6w2iixvp7jyffmd3gdq_157.0.8092.0/157.0.8092.0_chrome_installer_uncompressed.exe#/dl.7z",
