        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/gnjjlr6an4akthjrik2zmrpcni_159.0.8138.0/159.0.8138.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "efdeeb1b99d447a2a90582a1f7f5b2f2469e2604d077b82a6c900a1bd0536efe"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acfu2inp5yauiiihtvha3nvkegza_159.0.8138.0/159.0.8138.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "33f1b8ccbeb3300688f8fe851b8649e5712ad35f35dc90ad114af69fd7095046"
