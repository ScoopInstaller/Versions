        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adotrsjcvhm7izs6sm7ooc47mwsa_157.0.8098.0/157.0.8098.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "8983a82281ac461e246d00d1e04b8e24d5eccd25ae5e260745b79fbdd1eeeee0"
