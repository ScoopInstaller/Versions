            "hash": "391441c09e2d9407251934ce30cfe1e28497e693df195710e89b8b291fb2a0bd"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/cpzgjebnr4cig3vy7ysgajpwyu_157.0.8083.0/157.0.8083.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "02ffd38691ff4ad23cbfab4e30326c5ee0df460efb0c98017c6989f9b55fb12e"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad5ljvgy3ijr6htjh5zqty3vl4yq_157.0.8083.0/157.0.8083.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "7492deb366c28f393838731201a70530d61d7069db13f60634184777684185cc"
