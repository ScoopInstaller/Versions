            "hash": "9ed2810c74232366b4fd13b16ad56d38d7d28d842c655ee4037b1c8c91b13853"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/in4slboco5vbziszqzkui4mcfi_159.0.8140.0/159.0.8140.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "2e10bc198c84873ad769cd0f92af72face753b3db6f7e76ee1e2e25a5d3887f6"
