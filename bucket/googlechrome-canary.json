            "hash": "c390fc82302c5b246b7d3152783a56eb9dcc6632ca4c25933994135ccb64df1c"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ac3bmkmo2l6lgmcroopje26b65xa_160.0.8177.0/160.0.8177.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3aa3a9c381ae831e01c38d4ef2125eea51c19bc4adc8606346c637f3ed32e24f"
