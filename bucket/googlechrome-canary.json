            "hash": "dad43e8dcd8cd21ad5d48066b6c6c87835c0fa79bae4b51034e5e44c2a449e9f"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adwybt3ylm4xaclqbt22oxekakna_158.0.8121.0/158.0.8121.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "6d728c137c023e635db48a5d686933a35bb1faf9b8d36c54cee68f68f0d84c0c"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/d7jvou5ttuy4qyfxze6aw67xt4_158.0.8121.0/158.0.8121.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "b50d6424b6efe973264c0a93a93ac31ed9a0dca87f6e8a3735b240f6dd054e6c"
        }
