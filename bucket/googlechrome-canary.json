        "arm64": {
            "url": "https://dl.google.com/release2/chrome/aciwt6ko4g75k5gfeneu24ed35ea_154.0.8031.0/154.0.8031.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "0d3a651aa6739f421ca31b3a48ab76d71ac4790b468dd4ce4d66251f058dbefd"
