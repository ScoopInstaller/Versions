        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acj7qpzniwavtsnhmcqfdwdcog2q_159.0.8148.1/159.0.8148.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "92d0b0f03495790fd3524d6ebd31d927bc643ac41b88ead20bf8313cb4fa59ca"
