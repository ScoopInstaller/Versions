            "hash": "3af95415a59bf41bd1dd9d426b1f483eba2e12ac704b59da9e80029a67a26c35"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ls2psnl4m3pw4sjcgsh6bzmpbq_158.0.8111.0/158.0.8111.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "0c5efc1605b5b47d3dd3fadfe9a75132c446128921f1a193e26642196a0c940a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/c2gnnq32x72ksy2yt22yh5a7em_158.0.8111.0/158.0.8111.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "25b7aa39e33383d45500702c9870542ee2bb093937379e4778089b63855d262f"
