            "hash": "73115e2de2d6df3b32ee9c07ff9ec52f709bdf27d2c5c2c233dba3c125dd31f8"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/gnscjboet62vmogwu7bgthtyma_158.0.8125.0/158.0.8125.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "f9c39040225fb88071cc5754e0c3f7e8e1bfa97df1888ae36e8ecf376b08a9e3"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/aclhay5wyiv63ojaa42xppa66ica_158.0.8125.0/158.0.8125.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "243aa4dba7302617da87e00260e9e60c32abaa7151a9ee0a7751aa0e4c04f600"
