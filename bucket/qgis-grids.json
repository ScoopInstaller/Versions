{
    "version": "4.2.3-2",
    "description": "A free and open source geographic information system (GIS), with optional projection grids",
    "homepage": "https://www.qgis.org/",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://download.qgis.org/downloads/QGIS-Grids-OSGeo4W-4.2.3-2.msi",
            "hash": "d509c5216adc54b4bea1a5edfb8095c62064ad1c129d9b1c414b3f3c6690b10f"
        }
    },
    "extract_dir": "QGIS 4.2.3",
    "post_install": [
        "if (-not $global) {",
        "  (Get-Content \"$dir\\etc\\postinstall\\qgis.bat\" -Raw).Replace('\"%WINDIR%\\regedit\" /s', '\"%SystemRoot%\\System32\\reg.exe\" import') |",
        "    Set-Content \"$dir\\etc\\postinstall\\qgis.bat\" -Encoding Ascii",
        "  Get-ChildItem \"$dir\\apps\\qgis\" -Filter qgis.reg.tmpl -Recurse |",
        "    ForEach-Object { (Get-Content $_.FullName -Raw).Replace('HKEY_CLASSES_ROOT', 'HKEY_CURRENT_USER\\Software\\Classes') | Set-Content $_.FullName -Encoding Ascii }",
        "}",
        "& \"$dir\\etc\\postinstall.bat\" \"$(shortcut_folder $global)\\OSGeo4W\" \"$([Environment]::GetFolderPath('Desktop'))\\OSGeo4W\" 0 1"
    ],
    "bin": [
        "OSGeo4W.bat",
        "bin\\o4w_env.bat"
    ],
    "pre_uninstall": "& \"$dir\\etc\\preremove.bat\"",
    "checkver": {
        "url": "https://github.com/qgis/QGIS-Website/raw/main/data/conf.json",
        "jsonpath": "$.lr_grids_msi",
        "regex": "/QGIS-Grids-OSGeo4W-([\\d.]+(-\\d+)?)\\.msi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.qgis.org/downloads/QGIS-Grids-OSGeo4W-$version.msi",
                "hash": {
                    "url": "https://download.qgis.org/downloads/QGIS-Grids-OSGeo4W-$version.sha256sum"
                }
            }
        },
        "extract_dir": "QGIS $majorVersion.$minorVersion.$patchVersion"
    }
}
