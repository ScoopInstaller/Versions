{
    "version": "9.0.20",
    "description": "Microsoft .NET 9.0 Runtime, installed from the ZIP archive without admin rights",
    "homepage": "https://dotnet.microsoft.com/download/dotnet/9.0",
    "license": "MIT",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/9.0.20/dotnet-runtime-9.0.20-win-x64.zip",
            "hash": "sha512:6f7241fab7a8003813c3c8a59005e368fe53525e3cf08ab1cc052103f2f422af6bd1b20b838c283283a8a709d52a6aea2379686fe6cb07cc0fa7119f2ef2b2bf"
        },
        "32bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/9.0.20/dotnet-runtime-9.0.20-win-x86.zip",
            "hash": "sha512:c9679d5606604ff2970064d6ab9470b3b50e14ceb0a5efa67b3ce9b9e3b24d9edda2af102ac99623a8a0c3b83b645608027ec36483d928c917e83d2d00a60811"
        },
        "arm64": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/9.0.20/dotnet-runtime-9.0.20-win-arm64.zip",
            "hash": "sha512:9e8a6252d98f37fe035c7c642be479ea8b16db393e357ef248695c3f3cafb0656548d41e2e1a12d24ce62531f8190b48af02adb933bf25d5ecaa2a94415d2fc7"
        }
    },
    "post_install": [
        "# Link this runtime into the root shared by all .NET packages (side-by-side)",
        "$root = Join-Path (basedir $global) 'shared\\dotnet'",
        "foreach ($d in Get-ChildItem \"$original_dir\\host\\fxr\\*\", \"$original_dir\\shared\\*\\*\" -Directory) {",
        "    $link = Join-Path $root $d.FullName.Substring($original_dir.Length + 1)",
        "    New-Item -ItemType Directory -Force (Split-Path $link) | Out-Null",
        "    $old = Get-Item $link -Force -ErrorAction SilentlyContinue",
        "    if ($old -and (Test-Path $link)) { continue }",
        "    if ($old) { [IO.Directory]::Delete($link) }",
        "    New-Item -ItemType Junction -Path $link -Target $d.FullName | Out-Null",
        "}",
        "$exe = \"$root\\dotnet.exe\"",
        "if (!(Test-Path $exe) -or (Get-Item $exe).VersionInfo.FileVersionRaw -lt (Get-Item \"$original_dir\\dotnet.exe\").VersionInfo.FileVersionRaw) {",
        "    Copy-Item \"$original_dir\\dotnet.exe\" $exe -Force",
        "}",
        "New-Item -ItemType Junction -Path \"$original_dir\\dotnet-root\" -Target $root | Out-Null"
    ],
    "env_add_path": "dotnet-root",
    "env_set": {
        "DOTNET_ROOT": "$(basedir $global)\\shared\\dotnet"
    },
    "pre_uninstall": [
        "# Unlink this package's runtimes, handing each over to another installed package that provides it",
        "$root = Join-Path (basedir $global) 'shared\\dotnet'",
        "if (Get-Item \"$dir\\dotnet-root\" -Force -ErrorAction SilentlyContinue) { [IO.Directory]::Delete(\"$dir\\dotnet-root\") }",
        "if (Test-Path $root) {",
        "    $pattern = \"$root\\host\\fxr\\*\", \"$root\\shared\\*\\*\"",
        "    $owned = Get-ChildItem $pattern -Directory | Where-Object { \"$($_.Target)\".StartsWith(\"$dir\\\", 'OrdinalIgnoreCase') }",
        "    $others = Get-ChildItem (Join-Path (appsdir $global) '*\\*') -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Parent.FullName -ne (Split-Path $dir) } | Sort-Object { $_.Name -ne 'current' }",
        "    foreach ($l in $owned) {",
        "        $rel = $l.FullName.Substring($root.Length + 1)",
        "        [IO.Directory]::Delete($l.FullName)",
        "        $src = $others | ForEach-Object { Join-Path $(if ($_.Target) { \"$($_.Target)\" } else { $_.FullName }) $rel } | Where-Object { Test-Path $_ } | Select-Object -First 1",
        "        if ($src) { New-Item -ItemType Junction -Path $l.FullName -Target $src | Out-Null }",
        "    }",
        "    if (!(Get-ChildItem $pattern -Directory)) {",
        "        if (!(Test-Path \"$root\\sdk\")) { Remove-Item \"$root\\dotnet.exe\" -Force -ErrorAction SilentlyContinue }",
        "        foreach ($p in \"$root\\host\\fxr\", \"$root\\shared\\*\", \"$root\\host\", \"$root\\shared\", $root) {",
        "            Get-Item $p -ErrorAction SilentlyContinue | Where-Object { !(Get-ChildItem $_.FullName -Force) } | Remove-Item",
        "        }",
        "    }",
        "}"
    ],
    "post_uninstall": [
        "# env_set removal wiped DOTNET_ROOT; restore it while another runtime remains",
        "$root = Join-Path (basedir $global) 'shared\\dotnet'",
        "if (Test-Path $root) {",
        "    Set-EnvVar -Name 'DOTNET_ROOT' -Value $root -Global:$global",
        "    $env:DOTNET_ROOT = $root",
        "}"
    ],
    "checkver": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/releases-index.json",
        "jsonpath": "$.releases-index[?(@.channel-version == '9.0')].latest-runtime",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/$version/dotnet-runtime-$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/$version/dotnet-runtime-$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/$version/dotnet-runtime-$version-win-arm64.zip"
            }
        },
        "hash": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/$majorVersion.$minorVersion/releases.json",
            "regex": "(?s)$basename.*?$sha512"
        }
    }
}
